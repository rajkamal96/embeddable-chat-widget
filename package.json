{
  "name": "embeddable-chat-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Demo: an embeddable AI chat widget that answers only from a business's own content, with source links and honest refusals.",
  "scripts": {
    "widget": "vite build --config vite.widget.config.ts",
    "dev": "npm run widget && next dev --webpack",
    "build": "npm run widget && next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "marked": "^15.0.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
