# Required for real answers. Get a free key at https://aistudio.google.com/ and keep it server-side only.
GEMINI_API_KEY=

# Optional. Default is gemini-3.5-flash-lite (gemini-2.5-flash returned 404 for new keys).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Only for tests against a local stub. Leave unset in production.
# GEMINI_API_BASE=

# Off switch: set to "false" to make /api/chat return 503 without calling the model.
# CHAT_ENABLED=true

# Limits are per server instance (in memory). See README, "Security notes".
# CHAT_MAX_PER_10_MIN=8
# CHAT_MAX_PER_DAY=300
